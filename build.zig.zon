.{
    .name = .puny,
    .version = "0.3.5",
    .fingerprint = 0xcae65a8a91984534, // Changing this has security and trust implications.
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        // The provider clients are generated with this. It is lazy because
        // only `zig build regenerate-providers` needs it; building, testing
        // and releasing puny never fetches it.
        .openapi2zig = .{
            .url = "git+https://github.com/christianhelle/openapi2zig?ref=feature/library-generate-pipeline#0f30ef168e416c976ec6fd45105289c9cc3f72c9",
            .hash = "openapi2zig-0.5.3-ykENAtFbqAAUomwed3AiBFFN6wljNNDvYtaC1G4rwBF1",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "tests",
        "tools",
        "LICENSE",
        "README.md",
    },
}
