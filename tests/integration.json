{
  "default_args": [
    "--oneshot"
  ],
  "tests": [
    {
      "name": "opencode_go: Basic chat response",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--prompt",
        "Respond with just the word hello"
      ],
      "min_output_length": 1,
      "expect": [
        "hello"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ]
    },
    {
      "name": "opencode_go: Tool call read_file",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--prompt",
        "Read the file src/main.zig"
      ],
      "min_output_length": 1,
      "expect": [
        "const std = @import"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ]
    },
    {
      "name": "opencode_go: Tool call grep_search",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--prompt",
        "Search for 'pub fn' in the source code of src/main.zig"
      ],
      "min_output_length": 1,
      "expect": [
        "pub fn"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ]
    },
    {
      "name": "opencode_go: Tool call execute_shell",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--prompt",
        "Run 'echo hello world' in the shell"
      ],
      "min_output_length": 1,
      "expect": [
        "Exit code: 0",
        "hello world"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ]
    },
    {
      "name": "opencode_go: Tool call save_prd",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--prompt",
        "/plan testing save_prd tool. create an empty plan with no details"
      ],
      "min_output_length": 1,
      "expect": [
        "plan.md",
        "plan.html"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ],
      "evidence": {
        "extract_paths_from_output": true
      }
    },
    {
      "name": "opencode_zen: Basic chat response",
