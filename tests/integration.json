{
  "tests": [
    {
      "name": "opencode_go: Basic chat response",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--oneshot",
        "--prompt",
        "Respond with just the word hello"
      ],
      "min_output_length": 1,
      "expect": [
        "hello"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ]
    },
    {
      "name": "opencode_go: Tool call read_file",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--oneshot",
        "--prompt",
        "Read the file src/main.zig"
      ],
      "min_output_length": 1,
      "expect": [
        "const std = @import"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ]
    },
    {
      "name": "opencode_go: Tool call grep_search",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--oneshot",
        "--prompt",
        "Search for 'pub fn' in the source code of src/main.zig"
      ],
      "min_output_length": 1,
      "expect": [
        "pub fn"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ]
    },
    {
      "name": "opencode_go: Tool call execute_shell",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--oneshot",
        "--chat-log",
        "--prompt",
        "Run 'echo hello world' in the shell"
      ],
      "min_output_length": 1,
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ],
      "evidence": {
        "file_contains": {
          "path": "puny_chat.log",
          "patterns": ["[TOOL_RESULT]", "Exit code: 0", "hello world"]
        }
      }
    },
    {
      "name": "opencode_go: Tool call save_prd",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--oneshot",
        "--prompt",
        "/plan testing save_prd tool. create an empty plan with no details"
      ],
      "min_output_length": 1,
      "expect": [
        "plan.md",
        "plan.html"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ],
      "evidence": {
        "extract_paths_from_output": true
      }
    },
    {
      "name": "opencode_go: Markdown table renderer",
      "args": [
        "--provider",
        "opencode_go",
        "--model",
        "deepseek-v4-flash",
        "--oneshot",
        "--prompt",
        "im testing the markdown table renderer. generate a markdown table with a realistic data set"
      ],
      "min_output_length": 1,
      "expect": [
        "|",
        "---"
      ],
      "not_expect": [
        "Error:",
        "Chat failed",
        "Failed"
      ]
    },
